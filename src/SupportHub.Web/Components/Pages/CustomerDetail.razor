@page "/customers/{Id:guid}"
@rendermode InteractiveServer
@inject CustomerApiClient CustomerApi

<PageTitle>Customer details</PageTitle>

@if (_loading)
{
    <p role="status">Loading customer...</p>
}
else if (_notFound)
{
    <EmptyState Title="Customer not found" Description="This customer may have been removed or the link may be out of date." Icon="?">
        <a class="button button-secondary" href="customers">Back to customers</a>
    </EmptyState>
}
else if (_error is not null)
{
    <InlineError Message="@_error">
        <a class="button button-secondary" href="customers">Back to customers</a>
    </InlineError>
}
else if (_customer is not null)
{
    <PageHeader Title="@_customer.Name" Eyebrow="Customer profile"
                Lede="@_customer.Email">
        <Actions>
            <a class="button button-primary" href="@($"customers/{_customer.Id}/edit")">Edit customer</a>
        </Actions>
    </PageHeader>
    <div class="detail-grid">
        <SectionCard Heading="Contact details" Description="Information used by the support team.">
            <dl class="detail-list">
                <dt>Email</dt>
                <dd><a href="mailto:@_customer.Email">@_customer.Email</a></dd>
                <dt>Phone</dt>
                <dd>@(_customer.PhoneNumber ?? "Not provided")</dd>
            </dl>
        </SectionCard>
        <SectionCard Heading="Support coverage" Description="The account's service level.">
            <div class="profile-highlight">
                <StatusBadge Label="@SupportHubVocabulary.SupportTier(_customer.SupportTier.ToString())" Tone="@TierTone(_customer.SupportTier)" />
                <p>Use this tier when prioritizing service-level expectations for associated tickets.</p>
            </div>
        </SectionCard>
    </div>
    <a class="back-link" href="customers">← Back to customers</a>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerModel? _customer;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;

    private static string TierTone(SupportTierModel tier) =>
        tier switch
        {
            SupportTierModel.Enterprise => "info",
            SupportTierModel.Premium => "success",
            _ => "neutral"
        };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        try
        {
            _customer = await CustomerApi.GetCustomerAsync(Id);
            _notFound = _customer is null;
        }
        catch (CustomerApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
