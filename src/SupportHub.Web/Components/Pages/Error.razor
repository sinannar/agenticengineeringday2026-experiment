@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">System message</p>
        <h1>Something went wrong</h1>
        <p class="page-lede">SupportHub could not complete this request. Return to the overview and try again.</p>
    </div>
</div>

@if (ShowRequestId)
{
    <div class="state-panel state-panel-warning" role="status">
        <strong>Reference ID</strong>
        <code>@RequestId</code>
    </div>
}

<a class="button button-primary" href="/">Return to overview</a>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
