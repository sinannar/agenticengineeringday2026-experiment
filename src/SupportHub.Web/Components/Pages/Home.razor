@page "/"
@rendermode InteractiveServer
@inject TicketApiClient TicketApi

<PageTitle>Support dashboard</PageTitle>

<PageHeader Title="Overview" Eyebrow="Support workspace"
            Lede="A focused view of the work that needs attention across your queue.">
    <Actions>
        @if (_dashboard is not null)
        {
            <span class="freshness-label" aria-label="Dashboard freshness">@FreshnessLabel</span>
        }
    </Actions>
</PageHeader>

@if (_loading && _dashboard is null)
{
    <div class="state-panel" role="status">Loading overview metrics...</div>
}
else if (_error is not null)
{
    <InlineError Message="@_error">
        <button class="button button-primary" @onclick="LoadAsync">Try again</button>
    </InlineError>
}
else if (_dashboard is null || _dashboard.Summary.TotalTickets == 0)
{
    <EmptyState Title="Your queue is clear" Description="No tickets are available yet. Create a ticket to populate the overview." Icon="✓">
        <a class="button button-primary" href="tickets/new">Create a ticket</a>
    </EmptyState>
}
else
{
    @if (_loading)
    {
        <div class="state-panel" role="status">Refreshing overview metrics...</div>
    }

    @if (_dashboard.IsStale)
    {
        <div class="state-panel state-panel-warning mb-4" role="status">
            <strong>Cached overview</strong>
            <span>Last evaluated @(_dashboard.Summary.EvaluatedAtUtc.ToLocalTime().ToString("g")).</span>
            <button class="button button-secondary" @onclick="LoadAsync">Refresh</button>
        </div>
    }

    <div class="metric-grid mb-4">
        <MetricCard Title="Open tickets" Value="@_dashboard.Summary.OpenTickets" Tone="primary" Description="Active work in the queue" />
        <MetricCard Title="At-risk SLAs" Value="@_dashboard.Summary.AtRiskSlaTickets" Tone="warning" Description="Needs attention soon" />
        <MetricCard Title="Breached SLAs" Value="@_dashboard.Summary.BreachedSlaTickets" Tone="danger" Description="Past the target window" />
        <MetricCard Title="Total tickets" Value="@_dashboard.Summary.TotalTickets" Tone="secondary" Description="All tracked tickets" />
    </div>

    <div class="dashboard-grid">
        <SectionCard Heading="Tickets by status" Description="Current workload across the ticket lifecycle." HeadingId="status-heading">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr><th scope="col">Status</th><th scope="col">Count</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _dashboard.Summary.StatusBreakdown)
                        {
                            <tr>
                                <th scope="row">@SupportHubVocabulary.TicketStatus(item.Status.ToString())</th>
                                <td>@item.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </SectionCard>
        <SectionCard Heading="Tickets by priority" Description="Where urgency is concentrated." HeadingId="priority-heading">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr><th scope="col">Priority</th><th scope="col">Count</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _dashboard.Summary.PriorityBreakdown)
                        {
                            <tr>
                                <th scope="row">@SupportHubVocabulary.TicketPriority(item.Priority.ToString())</th>
                                <td>@item.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </SectionCard>
    </div>
}

@code {
    private DashboardSummaryReadModel? _dashboard;
    private bool _loading = true;
    private string? _error;

    private string FreshnessLabel =>
        _dashboard is null
            ? string.Empty
            : _dashboard.IsCached
                ? $"Evaluated {_dashboard.Summary.EvaluatedAtUtc.ToLocalTime():g}; cached {_dashboard.CacheAge.TotalSeconds:0.#}s ago"
                : $"Evaluated {_dashboard.Summary.EvaluatedAtUtc.ToLocalTime():g}; fresh";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _dashboard = await TicketApi.GetDashboardSummaryAsync();
        }
        catch (TicketApiException exception)
        {
            _dashboard = null;
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
